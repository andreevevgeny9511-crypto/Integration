{
  "name": "bitrix-listok-integration",
  "version": "1.0.0",
  "description": "Configurable API integration between Bitrix24 and Listok",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "jest",
    "test:unit": "jest --testPathPattern='unit'",
    "test:integration": "jest --testPathPattern='integration'",
    "test:coverage": "jest --coverage",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart"
  },
  "keywords": [
    "bitrix24",
    "listok",
    "integration",
    "crm",
    "sync"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^4.7.1",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.0",
    "node-cron": "^3.0.3",
    "joi": "^17.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
